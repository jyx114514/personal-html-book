{
  "name": "dialogue2course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1",
    "build": "node scripts/build-site.mjs",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check:scripts": "eslint scripts --max-warnings=0",
    "lint": "eslint scripts standalone docs/.vitepress/theme docs/.vitepress/config.mts eslint.config.mjs --max-warnings=0",
    "verify": "node scripts/verify-local.mjs",
    "verify:static": "node scripts/verify-local.mjs --static",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:html": "node scripts/verify-native-html.mjs",
    "sync:agents": "node scripts/sync-agent-instructions.mjs --write"
  },
  "dependencies": {
    "vitepress": "^1.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "^16.5.0",
    "markdown-it-mathjax3": "^4.3.2",
    "playwright": "1.64.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.71.2",
    "vite": "^5.4.21",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.26.0 <11"
  }
}
